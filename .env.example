# Database connection string
# Get this from your Supabase project settings -> Database -> Connection string
DATABASE_URL="<postgresql-connection-string>"

# Steam Web API key (get one free at https://steamcommunity.com/dev/apikey)
STEAM_API_KEY="<steam-web-api-key>"

# Upstash Redis — rate limiting (optional, no-ops locally without these)
# Get at: https://console.upstash.com → Create database → REST API
UPSTASH_REDIS_REST_URL="<upstash-rest-url>"
UPSTASH_REDIS_REST_TOKEN="<upstash-rest-token>"

# Sentry — error monitoring (optional, silent when unset)
# DSN: https://sentry.io → Project Settings → Client Keys
# Auth token: https://sentry.io → Settings → Auth Tokens
NEXT_PUBLIC_SENTRY_DSN="<public-sentry-dsn>"
SENTRY_AUTH_TOKEN="<sentry-auth-token>"

# Logging level (optional, defaults to "info")
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
